flowchart TD
  TTL["3. Activity Diagram Mengelola Cuti dan Sakit"]
  style TTL fill:#bcd9f5,stroke:#000,stroke-width:1px
  TTL --> S
  subgraph KARYAWAN["Karyawan"]
    direction TB
    S(( )) --> K1["Isi form jenis, tanggal, alasan, lampiran"]:::act --> K2["Kirim pengajuan"]:::act
    K3["Terima notifikasi hasil"]:::act --> E2(( ))
  end
  subgraph ADMIN["Admin"]
    direction TB
    A1["Buka antrean Menunggu Persetujuan"]:::act --> A2["Memverifikasi pengajuan"]:::act --> V{"Setujui?"}
    V -->|"Ya"| OK["Menyetujui pengajuan"]:::act
    V -->|"Tidak"| NO["Menolak pengajuan, isi keterangan minimal 10 karakter"]:::act
  end
  subgraph SISTEM["Sistem"]
    direction TB
    SV{"Cuti minimal H+7? Sakit bebas aturan"} -->|"Tidak memenuhi"| G0["Tolak dan tampilkan syarat 7 hari"]:::act --> E(( ))
    SV -->|"Memenuhi"| S1["Simpan status Pending dan notifikasi semua admin"]:::act --> E
    Q{"Kuota cukup dan tidak tumpang tindih?"} -->|"Tidak"| GQ["Tolak 422 kuota kurang atau tumpang tindih"]:::act --> E
    Q -->|"Ya"| TULIS["Tulis baris kehadiran per tanggal"]:::act --> N2["Kirim notifikasi hasil ke karyawan"]:::act --> E
    D2["Simpan status pengajuan"]:::act --> E(( ))
  end
  K2 --> SV
  OK --> Q
  NO --> D2
  classDef act fill:#fff,stroke:#000;
  style S fill:#000,stroke:#000
  style E fill:#000,stroke:#f00,stroke-width:4px
  style E2 fill:#000,stroke:#f00,stroke-width:4px
  style KARYAWAN fill:#fff,stroke:#000
  style ADMIN fill:#fff,stroke:#000
  style SISTEM fill:#fff,stroke:#000
  style V fill:#d6eaf8,stroke:#000
  style SV fill:#d6eaf8,stroke:#000
  style Q fill:#d6eaf8,stroke:#000

flowchart TD
  TTL["1. Activity Diagram Login"]
  style TTL fill:#bcd9f5,stroke:#000,stroke-width:1px
  TTL --> S
  subgraph PENGGUNA["Pengguna"]
    direction TB
    S(( )) --> L1["Buka halaman login"]:::act --> L2["Isi email dan password"]:::act --> L3["Klik tombol Login"]:::act
  end
  subgraph SISTEM["Sistem"]
    direction TB
    V{"Valid?"} -->|"Tidak"| G["Tampilkan pesan tidak sesuai, ulangi login"]:::act --> E2(( ))
    V -->|"Ya"| D["Menampilkan dashboard sesuai peran"]:::act --> E(( ))
  end
  L3 --> V
  classDef act fill:#fff,stroke:#000;
  style S fill:#000,stroke:#000
  style E fill:#000,stroke:#f00,stroke-width:4px
  style E2 fill:#000,stroke:#f00,stroke-width:4px
  style PENGGUNA fill:#fff,stroke:#000
  style SISTEM fill:#fff,stroke:#000
  style V fill:#d6eaf8,stroke:#000

flowchart TD
  TTL["4. Activity Diagram Mengelola Penggajian"]
  style TTL fill:#bcd9f5,stroke:#000,stroke-width:1px
  TTL --> S
  subgraph ADMIN["Admin"]
    direction TB
    S(( )) --> L1["Pilih bulan periode"]:::act --> L2["Klik Generate penggajian"]:::act
    L3["Verifikasi hasil per karyawan"]:::act
    L4["Tandai Dibayar"]:::act
  end
  subgraph SISTEM["Sistem"]
    direction TB
    H["Hitung gaji pokok, tunjangan, reward, potongan, minimal nol"]:::act --> SV["Simpan, timpa baris lama, reset status ke Draft"]:::act
    V["Ubah status Terverifikasi"]:::act
    B["Ubah status Dibayar"]:::act
  end
  subgraph KARYAWAN["Karyawan"]
    direction TB
    K1["Lihat slip gaji milik sendiri"]:::act --> K2["Unduh slip PDF"]:::act --> E(( ))
  end
  L2 --> H
  L3 --> V
  L4 --> B
  B --> K1
  classDef act fill:#fff,stroke:#000;
  style S fill:#000,stroke:#000
  style E fill:#000,stroke:#f00,stroke-width:4px
  style ADMIN fill:#fff,stroke:#000
  style SISTEM fill:#fff,stroke:#000
  style KARYAWAN fill:#fff,stroke:#000
